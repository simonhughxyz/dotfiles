# Super+Alt+Shift+{H,J,K,L} to resize views
riverctl map normal $mod+Alt Left resize horizontal -100
riverctl map normal $mod+Alt Down resize vertical 100
riverctl map normal $mod+Alt Up resize vertical -100
riverctl map normal $mod+Alt Right resize horizontal 100

riverctl map normal $mod+Control Left move left 100
riverctl map normal $mod+Control Down move down 100
riverctl map normal $mod+Control Up move up 100
riverctl map normal $mod+Control Right move right 100

# # Mod + Left Mouse Button to move views
riverctl map-pointer normal $mod BTN_LEFT move-view

# # Mod + Right Mouse Button to resize views
riverctl map-pointer normal $mod BTN_RIGHT resize-view

tag() {
    key="$1"
    tag="$(gettag "$2")"

    # focus tag
    # riverctl map normal $mod $key spawn "river-cmd focus_tags '$2' '$tag'"
    riverctl map normal $mod $key spawn "flow toggle-tags '$tag'"
    # to tag focused view with tag
    riverctl map normal $mod+Shift $key set-view-tags $tag
    # toggle focus of tag
    riverctl map normal $mod+Control $key toggle-focused-tags $tag
    # toggle tag [0-8] of focused view
    riverctl map normal $mod+Shift+Control $key toggle-view-tags $tag
}

set_tags(){
    for i in $(seq 1 9)
    do
        tag "$i" "$i"
    done

    tag "0" "10"

    for i in $(seq 1 12)
    do
        tag "F${i}" "$((${i} + 10))"
    done
}

set_tags

# Mod+a to focus all tags
# Mod+Shift+a to tag focused view with all tags
riverctl map normal $mod a set-focused-tags $all_tags
riverctl map normal $mod+Shift a set-view-tags $all_tags

# # Mod+Space to toggle float
riverctl map normal $mod+Shift Space toggle-float

# # Mod+F to toggle fullscreen
riverctl map normal $mod F send-layout-cmd luatile "toggle_monocle()"
riverctl map normal $mod+Shift F toggle-fullscreen
riverctl map normal $mod+Shift G send-layout-cmd luatile "toggle_gapt()"

