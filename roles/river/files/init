# riverctl rule-add no-float -app-id "term"
# riverctl rule-add no-float -app-id "term"

# Mod+Shift+Delete to exit river
riverctl map normal $mod+Shift Delete exit

#
# Basic window control and navigation
#

# Use the "logo" key as the primary modifier
mod="Mod4"

riverctl map normal $mod Q close    # close a window
# Mod+J and Mod+K to focus the next/previous view in the layout stack
riverctl map normal $mod j focus-view next
riverctl map normal $mod k focus-view previous
riverctl map normal $mod l spawn "flow cycle-tags next"
riverctl map normal $mod h spawn "flow cycle-tags previous"

riverctl map normal $mod u toggle-focused-tags ${scratch_tag}
riverctl map normal $mod z spawn "wl-kbptr"

# The scratchpad will live on an unused tag. Which tags are used depends on your
# config, but rivers default uses the first 9 tags.
scratch_tag=$((1 << 32 ))

# Toggle the scratchpad with Super+P
riverctl map normal Super u toggle-focused-tags ${scratch_tag}

# Send windows to the scratchpad with Super+Shift+P
riverctl map normal Super+Shift u set-view-tags ${scratch_tag}

# Set spawn tagmask to ensure new windows don't have the scratchpad tag unless
# explicitly set.
all_but_scratch_tag=$(( ((1 << 32) - 1) ^ $scratch_tag ))
riverctl spawn-tagmask ${all_but_scratch_tag}


# insert mode
riverctl declare-mode insert
riverctl map normal $mod i enter-mode insert
riverctl map insert $mod escape enter-mode normal
riverctl map insert $mod bracketleft enter-mode normal
riverctl map insert $mod+Control bracketleft enter-mode normal


riverctl declare-mode output
riverctl map normal $mod o enter-mode output
riverctl map g $mod escape enter-mode normal
riverctl map g $mod bracketleft enter-mode normal
riverctl map g $mod+Control bracketleft enter-mode normal

# extra g mode
riverctl declare-mode g
riverctl map normal $mod g enter-mode g
riverctl map g $mod escape enter-mode normal
riverctl map g $mod bracketleft enter-mode normal
riverctl map g $mod+Control bracketleft enter-mode normal
riverctl map g $mod a spawn 'echo "audiebant" > "$XDG_RUNTIME_DIR/work_mode"'
riverctl map g $mod n spawn 'echo "normal" > "$XDG_RUNTIME_DIR/work_mode"'




# notifications
riverctl map normal $mod period spawn "dunstctl history-pop"
riverctl map normal $mod comma spawn "dunstctl close"
riverctl map normal $mod numbersign spawn "$( termcmd "fdunst" "fdunst" "fdunst" )"


# Mod+Shift+Return to start an instance of foot (https://codeberg.org/dnkl/foot)
riverctl map normal $mod Return spawn "/bin/foot -a 'term' /usr/bin/zsh"
riverctl map normal Control+Mod1 delete spawn "$( termcmd "powermenu" "Power" "powermenu" )"
riverctl map normal $mod X spawn "lock"

riverctl map normal $mod+Shift P spawn "$( termcmd "passmenu" "Pass" "PASS_FILTER='^x/.*$' pass menu" )"
riverctl map normal $mod+Alt P spawn "$( termcmd "passmenu" "Pass" "pass menu" )"
riverctl map normal $mod O spawn "$( termcmd "appmenu" "Apps" "appmenu" )"
riverctl map normal $mod C spawn "$( termcmd "clipmenu" "Clipboard" "fclip" )"
