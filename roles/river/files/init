# Set default options
riverctl background-color 0x000000
riverctl border-color-focused 0xff00ff
riverctl border-color-unfocused 0x000000
riverctl border-width 4
riverctl focus-follows-cursor disabled
riverctl hide-cursor 5000
riverctl hide-cursor-when-typing enabled
#riverctl keyboard-layout -options "caps:swapescape,altwin:prtsc_rwin" "gb"
riverctl keyboard-layout -options "altwin:prtsc_rwin" "gb"

# get tag value
gettag(){ eval "echo \$(( 1 << ($1 - 1) ))"; }
all_tags=4294967295
scratch_tag=$(( 1 << 32 ))

termcmd(){
    # printf "foot -a %s -T %s -w '%sx%s' -e %s" "$1" "$2" "${4:-700}" "${5:-500}" "$3"
    printf "foot -a %s -T %s -w '%sx%s' -e zsh -ic '%s'" "$1" "$2" "${4:-700}" "${5:-500}" "$3"
}

