#!/bin/bash

# This is the example configuration file for river.
#
# If you wish to edit this, you will probably want to copy it to
# $XDG_RIVER_CONFIG_HOME/river/init or $HOME/.config/river/init first.
#
# See the river(1), riverctl(1), and rivertile(1) man pages for complete
# documentation.

# dbus_launch="$( dbus-launch --sh-syntax )"
# eval "$dbus_launch"
# printf "%s" "$dbus_launch" > "$XDG_RUNTIME_DIR/dbus_launch"

RIVER_CONFIG="${RIVER_CONFIG:-${XDG_RIVER_CONFIG_HOME}/river}"
RIVER_RUNTIME="${RIVER_RUNTIME:-${XDG_RUNTIME_DIR}/river}"

mkdir -p "$RIVER_CONFIG"
mkdir -p "$RIVER_RUNTIME"


rm -f "${RIVER_RUNTIME}/tags"
rm -f "${RIVER_RUNTIME}/title"
rm -f "${RIVER_RUNTIME}/viewstag"

mkfifo "${RIVER_RUNTIME}/tag"
mkfifo "${RIVER_RUNTIME}/title"
mkfifo "${RIVER_RUNTIME}/viewstag"

# eval "${RIVER_CONFIG}/winitrc"

# create state change pipes and files
ristate -t -w -u | while IFS= read -r line; do
    printf "%s" "$line" | jq -rc ".tags.AUOptronics" | tr -d '["]' > "${RIVER_RUNTIME}/tags"
done &
ristate -t -w -u | while IFS= read -r line; do
    printf "%s" "$line" | jq -rc ".title" > "${RIVER_RUNTIME}/title"
done &
ristate -vt | while IFS= read -r line; do
    printf "%s\n" "$line" | jq -rc ".viewstag.AUOptronics?" | tr -d '["]' > "${RIVER_RUNTIME}/viewstag"
done &


ristate -t -w -u | while IFS= read -r line; do
    printf "%s" "$line" | jq -rc ".tags.AUOptronics" | tr -d '["]' > "${RIVER_RUNTIME}/current_tags"
done &
ristate -t -w -u | while IFS= read -r line; do
    printf "%s" "$line" | jq -rc ".title" > "${RIVER_RUNTIME}/current_title"
done &

