riverctl map normal $mod+Shift C spawn "$( termcmd "calc" "Calc" "qalc" )"
riverctl map normal $mod Y spawn "$( termcmd "ytdl" "ytdl" "ytdl -m" )"

riverctl map normal $mod N spawn "$( termcmd "nvimmail" "Mail" "nvim -c \"lua require([[notmuch]]).search_terms([[tag:inbox]])\"" )"
riverctl map normal $mod R spawn "$( termcmd "newsraft" "newsraft" "newsraft" )"
riverctl map normal $mod+Shift Return spawn "$( termcmd "lf" "lf" "lf" )"
riverctl map normal $mod T spawn "$( termcmd "bottom" "bottom" "btm -b" )"
riverctl map normal $mod+Shift T spawn "$( termcmd "bottom" "bottom" "btm" )"
riverctl map normal $mod M spawn "$( termcmd "netomutt" "mail" "netomutt" )"
riverctl map normal $mod P spawn "$( termcmd "pulsemixer" "pulsemixer" "pulsemixer" )"
riverctl map normal $mod+Shift y spawn "wl-paste | wtype -d 10 -"

# Screen shot
riverctl map normal $mod S spawn "shot"
riverctl map normal $mod+Shift S spawn "shot -s"


# Web Browser
riverctl map normal $mod w spawn www
riverctl declare-mode www
riverctl map normal $mod+Shift W enter-mode www
riverctl map normal $mod E enter-mode calendar
riverctl map www $mod x spawn "sh -c 'echo xxx > /tmp/qute.profile'; riverctl enter-mode normal"
riverctl map www $mod a spawn "sh -c 'echo alaska > /tmp/qute.profile'; riverctl enter-mode normal"
riverctl map www $mod escape enter-mode normal


# Calendar
riverctl declare-mode calendar
riverctl map normal $mod E enter-mode calendar
riverctl map calendar $mod escape enter-mode normal

calendar(){
    start="$( date -d "${2}/1" "+%d %b %Y" )"
    riverctl map calendar $mod $1 spawn "rem-calendar pdf ${start} $3 | zathura - & riverctl enter-mode normal"
}

calendar "E" "$( date "%b" )" "12"

for i in $(seq 1 12)
do
    calendar "F${i}" "${i}" "1"
done

# Mod+Shift+J and Mod+Shift+K to swap the focused view with the next/previous
# view in the layout stack
riverctl map normal $mod+Ctrl L swap next
riverctl map normal $mod+Ctrl H swap previous
riverctl map normal $mod Tab focus-previous-tags
riverctl map normal $mod+Ctrl Tab send-to-previous-tags
riverctl map normal $mod BackSpace focus-previous-tags
riverctl map normal $mod+Ctrl BackSpace send-to-previous-tags

# # Mod+Period and Mod+Comma to focus the next/previous output
# riverctl map normal $mod Period focus-output next
# riverctl map normal $mod Comma focus-output previous

# Mod+Shift+J and Mod+Shift+K to swap the focused view with the next/previous
# view in the layout stack
riverctl map normal $mod+Shift L focus-output next
riverctl map normal $mod+Shift H focus-output previous

# # Mod+Shift+{Period,Comma} to send the focused view to the next/previous output

riverctl map normal $mod+Shift+Alt L send-to-output next
riverctl map normal $mod+Shift+Alt H send-to-output previous

# # Mod+Return to bump the focused view to the top of the layout stack
riverctl map normal $mod Z zoom

#brightness
riverctl declare-mode brightness
riverctl map normal $mod B enter-mode brightness
riverctl map brightness $mod escape enter-mode normal

brightness(){
    riverctl map brightness $mod $1 spawn "river-cmd brightness ${2}0"
}

for i in $(seq 1 9)
do
    brightness "$i" "$i"
done
brightness "0" "10"

