# Generated by Ansible — do not edit

# Ensure cache dir exists (only if needed)
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# ---- Completion paths ----
{% for p in zsh_plugins if p.fpath is defined %}
fpath+=("{{ zsh_plugins_dir }}/{{ p.name }}/{{ p.fpath if p.fpath is not none else '' }}")
{% endfor %}

# ---- Completion init ----
autoload -Uz compinit
# Only regenerate dump file if it's older than 24 hours (requires extended_glob)
{
  setopt local_options extended_glob
  if [[ -f "$ZSH_CACHE_DIR/zcompdump" && -n "$ZSH_CACHE_DIR/zcompdump"(#qN.mh-24) ]]; then
    compinit -C -d "$ZSH_CACHE_DIR/zcompdump"   # dump is fresh, skip security check
  else
    compinit -d "$ZSH_CACHE_DIR/zcompdump"       # dump missing or >24h old, regenerate
  fi
}

# ---- Immediate plugins ----
{% for p in zsh_plugins if p.source is defined and p.source is not none and not p.lazy | default(false) %}
source "{{ zsh_plugins_dir }}/{{ p.name }}/{{ p.source }}"
{% endfor %}

# ---- Lazy plugins ----
{% set lazy_plugins = zsh_plugins | selectattr('lazy', 'defined') | selectattr('lazy') | list %}
{% if lazy_plugins | length > 0 %}
autoload -Uz add-zsh-hook

__zsh_lazy_load() {
  add-zsh-hook -d precmd __zsh_lazy_load
{% for p in lazy_plugins %}
  source "{{ zsh_plugins_dir }}/{{ p.name }}/{{ p.source }}"
{% endfor %}
}

add-zsh-hook precmd __zsh_lazy_load
{%- endif %}
